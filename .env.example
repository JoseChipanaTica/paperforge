# Local only: lets `bun run dev` read papers other than the bundled sample. On the hosted
# site, leave this unset: visitors paste their own key in the browser.
ANTHROPIC_API_KEY=

# Claude model when a request names none (CLI scripts; default claude-opus-5-5). Visitors pick theirs on the site.
# PAPERFORGE_MODEL=claude-opus-5-5

# How hard Claude thinks while reading: low | medium | high
PAPERFORGE_EFFORT=medium

# Gallery database. Unset → a local SQLite file at data/paperforge.db.
# On Vercel: the Neon (Postgres) connection string, e.g. postgres://…?sslmode=require
DATABASE_URL=

# Signs "publish to gallery" tokens so only graphs this server generated can be saved.
# Required in production (any long random string: `openssl rand -hex 32`). Optional locally.
PAPERFORGE_SECRET=

PORT=3000
