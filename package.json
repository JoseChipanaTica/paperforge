{
  "name": "paperforge",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot ./index.ts",
    "start": "NODE_ENV=production bun ./index.ts",
    "build": "bun build ./src/web/index.html --outdir public --minify && cp src/web/icons/* public/",
    "forge": "bun ./scripts/forge.ts",
    "learn": "bun ./scripts/learn.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/katex": "^0.16.7",
    "@types/three": "^0.187.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
